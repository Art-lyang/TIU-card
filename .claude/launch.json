{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "autoPort": true,
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import os,http.server;http.server.ThreadingHTTPServer.allow_reuse_address=True;port=int(os.environ.get('PORT','8080'));http.server.ThreadingHTTPServer(('',port),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ]
    }
  ]
}
