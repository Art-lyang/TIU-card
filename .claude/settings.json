{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-push-verify.sh",
            "if": "Bash(git push*)",
            "timeout": 120,
            "statusMessage": "푸시 전 검증 (validator + JS 구문)..."
          }
        ]
      }
    ]
  }
}
